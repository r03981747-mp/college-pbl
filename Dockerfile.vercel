# Full Smart Campus application for Vercel's Container runtime.
# Spring Boot serves both the REST API and the static frontend from this image,
# so the browser always calls /api on the same origin.
#
# Required Vercel environment variables:
#   SPRING_DATASOURCE_URL       jdbc:mysql://HOST:PORT/DATABASE?sslMode=REQUIRED...
#   SPRING_DATASOURCE_USERNAME  database user
#   SPRING_DATASOURCE_PASSWORD  database password
# Optional:
#   APP_EXPORT_DIRECTORY=/tmp/exports
#   APP_LOG_DIRECTORY=/tmp/logs
#   APP_UPLOAD_DIRECTORY=/tmp/uploads
#   APP_DB_ACADEMIC_MIGRATION_ENABLED=true
#   DB_POOL_SIZE=3
#   DB_MIN_IDLE=1
#
# Vercel's container filesystem is ephemeral. /tmp/uploads keeps assignment
# uploads working for the life of an instance, but production needs a mounted
# volume or object storage for durable files.

FROM maven:3.9.9-eclipse-temurin-17 AS build
WORKDIR /src
COPY backend/pom.xml backend/pom.xml
COPY backend/src backend/src
RUN mvn -B -f backend/pom.xml package -DskipTests

FROM eclipse-temurin:17-jre-alpine
WORKDIR /app/backend
COPY --from=build /src/backend/target/smart-campus-backend-1.0.0.jar app.jar
COPY frontend /app/frontend
RUN mkdir -p /tmp/exports /tmp/logs /tmp/uploads
ENV APP_EXPORT_DIRECTORY=/tmp/exports \
    APP_LOG_DIRECTORY=/tmp/logs \
    APP_UPLOAD_DIRECTORY=/tmp/uploads \
    TZ=Asia/Kolkata \
    JAVA_TOOL_OPTIONS="-Duser.timezone=Asia/Kolkata"
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
