# ---------------------------------------------------------------------------
# Smart Campus - Vercel Container runtime environment variables
# Copy these values into Vercel > Project > Settings > Environment Variables.
# Never commit a real .env file.
# ---------------------------------------------------------------------------

# Managed MySQL-compatible connection (TiDB Cloud Starter, Aiven, Railway, ...).
# TiDB Cloud's public endpoint uses port 4000 and requires TLS.
# The TiDB username includes the SQL user prefix, e.g. abcd1234.smartcampus.
# Example:
# jdbc:mysql://gateway01.us-east-1.prod.aws.tidbcloud.com:4000/smart_campus_db?sslMode=REQUIRED&allowPublicKeyRetrieval=true&characterEncoding=UTF-8&serverTimezone=Asia/Kolkata
SPRING_DATASOURCE_URL=jdbc:mysql://HOST:PORT/DATABASE?sslMode=REQUIRED&allowPublicKeyRetrieval=true&characterEncoding=UTF-8&serverTimezone=Asia/Kolkata
SPRING_DATASOURCE_USERNAME=prefix.username
SPRING_DATASOURCE_PASSWORD=replace-me

# Vercel's filesystem is read-only except /tmp.
APP_EXPORT_DIRECTORY=/tmp/exports
APP_LOG_DIRECTORY=/tmp/logs

# Assignment files are stored outside the web root and served only through
# authenticated download endpoints. Vercel's /tmp is ephemeral, so use a
# mounted volume or object storage for durable production uploads.
APP_UPLOAD_DIRECTORY=/tmp/uploads
APP_UPLOAD_MAX_SIZE_MB=20
APP_DB_ACADEMIC_MIGRATION_ENABLED=true

# Keep the connection pool small because Vercel can run several instances.
DB_POOL_SIZE=3
DB_MIN_IDLE=1
